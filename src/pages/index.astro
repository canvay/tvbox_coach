---
import { BaseLayout, SiteFooter, SiteHeader } from '@prosefly/astro-theme-lotus/layouts';
import {
  FeatureCard,
  FeatureGrid,
  Hero,
  PageContainer,
  PageSection,
} from '@prosefly/astro-theme-lotus/blocks';
import { tools } from '../data/tools';

const steps = [
  {
    title: '获取接口地址',
    desc: '拿到一个可用的配置地址（URL 或 JSON 内容），它是 TVBox 的一切内容入口。',
  },
  {
    title: '进入设置页',
    desc: '打开 TVBox，在主界面找到「配置」或「设置」入口，进入配置地址填写页。',
  },
  {
    title: '填入并保存',
    desc: '粘贴配置地址或内容，保存后返回首页，等待站点与直播源加载完成。',
  },
  {
    title: '验证与更新',
    desc: '进入影视或直播页面确认数据正常；配置失效时，换一个接口地址重新加载。',
  },
];
---

<BaseLayout
  title="TVBox Coach — TVBox 使用教程与工具箱"
  description="TVBox 配置说明、核心概念介绍，以及一些帮助使用的浏览器端小工具。"
>
  <SiteHeader currentPath="/" surface search={false} />

  <main>
    <Hero
      title="玩转 TVBox，从这里开始"
      description="TVBox 配置说明、核心概念介绍，以及一些帮助使用的浏览器端小工具。"
    >
      <a slot="title" href="/" class="text-(--lotus-text-strong)">
        玩转 TVBox，<span class="text-(--lotus-accent)">从这里开始</span>
      </a>
      <a
        slot="actions"
        href="/tutorials/"
        class="inline-flex min-h-10 items-center rounded-lg border border-(--lotus-border-muted) px-5 text-sm font-medium text-(--lotus-text-strong) transition-colors hover:bg-(--lotus-surface)"
      >
        阅读教程
      </a>
      <a
        slot="actions"
        href="/tools/"
        class="inline-flex min-h-10 items-center rounded-lg bg-(--lotus-accent) px-5 text-sm font-medium text-(--lotus-accent-contrast) transition-opacity hover:opacity-90"
      >
        进入工具箱
      </a>
      <div slot="visual">
        <img
          src="/images/tvbox-ui.jpg"
          alt="TVBox 主界面示意：推荐、站点、直播等入口"
          width="600"
          height="270"
          loading="eager"
          class="w-full rounded-xl border border-(--lotus-border-subtle) shadow-lg"
        />
      </div>
    </Hero>

    <!-- 1. TVBox 是什么 -->
    <PageSection padding="lg">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-3xl font-semibold tracking-tight text-(--lotus-text-strong)">
          TVBox 是什么？
        </h2>
        <a
          href="/tutorials/intro/"
          class="shrink-0 text-sm font-medium text-(--lotus-accent) hover:underline"
        >
          查看完整介绍 →
        </a>
      </div>
      <div class="mt-5 flex flex-col items-start gap-8 md:flex-row md:items-center">
        <div class="min-w-0 flex-1">
          <p class="max-w-3xl text-[15.5px] leading-7 text-(--lotus-text)">
            TVBox 是一款运行在 Android 电视盒子 / 电视 / 手机上的<strong
              class="font-semibold text-(--lotus-text-strong)">开源播放器壳应用</strong
            >，本体不提供任何影视内容——它通过加载一份 JSON 配置文件，动态接入各类影视数据源，
            从而聚合播放网络上的影视资源。
          </p>
          <ul class="mt-4 max-w-3xl">
        <li class="relative border-b border-(--lotus-border-subtle) py-2 pl-6 text-sm leading-6 text-(--lotus-text) before:absolute before:left-1 before:top-4 before:size-1.5 before:rounded-full before:bg-(--lotus-accent)">
          <strong class="font-semibold text-(--lotus-text-strong)">播放内核</strong> —
          基于 ExoPlayer / IJKPlayer，支持 HTTP、HLS（m3u8）、DASH、MP4 等常见流媒体格式
        </li>
        <li class="relative border-b border-(--lotus-border-subtle) py-2 pl-6 text-sm leading-6 text-(--lotus-text) before:absolute before:left-1 before:top-4 before:size-1.5 before:rounded-full before:bg-(--lotus-accent)">
          <strong class="font-semibold text-(--lotus-text-strong)">工作方式</strong> —
          「播放器壳 + JSON 配置」的插件化形态，核心价值在配置而非内置内容
        </li>
        <li class="relative py-2 pl-6 text-sm leading-6 text-(--lotus-text) before:absolute before:left-1 before:top-4 before:size-1.5 before:rounded-full before:bg-(--lotus-accent)">
          <strong class="font-semibold text-(--lotus-text-strong)">生态现状</strong> —
          原作者 takagen99 的 TVBoxOSC 已停更，现在活跃的都是社区分支（影视仓、OK影视等）
        </li>
          </ul>
        </div>
        <a
          href="https://pan.quark.cn/s/f0a65d6cad33"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex shrink-0 flex-col items-center gap-3"
        >
          <img
            src="/images/tvbox-app-icon.png"
            alt="TVBox 应用图标"
            width="160"
            height="160"
            loading="lazy"
            class="size-36 rounded-3xl transition-transform group-hover:scale-105"
          />
          <span
            class="inline-flex min-h-10 items-center rounded-lg border border-(--lotus-border-muted) px-5 text-sm font-medium text-(--lotus-text-strong) transition-colors group-hover:bg-(--lotus-surface)"
          >
            ⬇️ 前往下载
          </span>
        </a>
      </div>
      <div class="mt-5 flex flex-wrap gap-2.5">
        <a
          href="https://github.com/takagen99/Box"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-full border border-(--lotus-border-muted) px-3.5 py-1 text-[13.5px] font-medium text-(--lotus-text) transition-colors hover:bg-(--lotus-surface)"
        >
          🐙 GitHub 仓库 ↗
        </a>
        <a
          href="https://tvbox.clbug.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-full border border-(--lotus-border-muted) px-3.5 py-1 text-[13.5px] font-medium text-(--lotus-text) transition-colors hover:bg-(--lotus-surface)"
        >
          📺 TVBox 发布站（非官方） ↗
        </a>
      </div>
    </PageSection>

    <!-- 2. 如何配置 TVBox 源 -->
    <PageSection padding="lg" class="border-t border-(--lotus-border-subtle)">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-3xl font-semibold tracking-tight text-(--lotus-text-strong)">
          如何配置 TVBox 源？
        </h2>
        <a
          href="/tutorials/config-setup/"
          class="shrink-0 text-sm font-medium text-(--lotus-accent) hover:underline"
        >
          详细教程 →
        </a>
      </div>
      <ol class="mt-6 grid list-none gap-4 p-0 sm:grid-cols-2 xl:grid-cols-4">
        {
          steps.map((step, i) => (
            <li class="rounded-[min(var(--lotus-radius-lg),1rem)] border border-(--lotus-border-muted) p-5">
              <span class="inline-flex size-8 items-center justify-center rounded-full bg-(--lotus-accent-soft) text-sm font-bold text-(--lotus-accent)">
                {i + 1}
              </span>
              <h3 class="mt-3.5 text-[15.5px] font-semibold text-(--lotus-text-strong)">
                {step.title}
              </h3>
              <p class="mt-1.5 text-[13.5px] leading-6 text-(--lotus-text-muted)">{step.desc}</p>
            </li>
          ))
        }
      </ol>
    </PageSection>

    <!-- 3. 工具入口 -->
    <PageSection padding="lg" class="border-t border-(--lotus-border-subtle)">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-3xl font-semibold tracking-tight text-(--lotus-text-strong)">实用工具</h2>
        <a href="/tools/" class="shrink-0 text-sm font-medium text-(--lotus-accent) hover:underline">
          查看全部 →
        </a>
      </div>
      <FeatureGrid columns={3} class="mt-6">
        {
          tools.map((tool) => (
            <FeatureCard
              href={tool.path}
              icon={tool.iconName}
              title={tool.name}
              description={tool.desc}
            />
          ))
        }
      </FeatureGrid>
    </PageSection>

    <!-- 4. 更多知识入口 -->
    <PageSection padding="lg" class="border-t border-(--lotus-border-subtle)">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-3xl font-semibold tracking-tight text-(--lotus-text-strong)">
          更多 TVBox 知识
        </h2>
        <a
          href="/tutorials/"
          class="shrink-0 text-sm font-medium text-(--lotus-accent) hover:underline"
        >
          浏览全部教程 →
        </a>
      </div>
      <FeatureGrid columns={3} class="mt-6">
        <FeatureCard
          href="/tutorials/live-source/"
          icon="lucide:radio-tower"
          title="直播源设置"
          description="认识 txt（#genre#）与 m3u 两种直播源格式，学会配置、转换和自制直播源。"
        />
        <FeatureCard
          href="/tutorials/faq/"
          icon="lucide:life-buoy"
          title="常见问题排查"
          description="集中回答 TVBox 使用中的高频问题：配置加载失败、播放卡顿、直播没台、应用闪退等。"
        />
        <FeatureCard
          href="/tutorials/"
          icon="lucide:book-open"
          title="全部教程"
          description="入门、配置、直播、FAQ——按顺序阅读，系统掌握 TVBox 的使用方法。"
        />
      </FeatureGrid>
    </PageSection>
  </main>

  <SiteFooter />
</BaseLayout>
