---
import ToolLayout from '../../components/tools/ToolLayout.astro';
import { FeatureCard, FeatureGrid } from '@prosefly/astro-theme-lotus/blocks';
import { tools } from '../../data/tools';
---

<ToolLayout
  title="工具箱"
  description="TVBox 浏览器端工具箱：接口解析、直播源转换、接口测活。全部工具均在浏览器本地运行，不采集、不上传任何数据，可放心使用。"
  currentPath="/tools/"
  sidebar={false}
>
  <FeatureGrid columns={3}>
    {
      tools.map((tool) => (
        <FeatureCard
          href={tool.path}
          icon={tool.iconName}
          title={tool.name}
          description={tool.desc}
        />
      ))
    }
  </FeatureGrid>
</ToolLayout>
