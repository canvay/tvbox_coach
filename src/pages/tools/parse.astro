---
import ToolLayout from '../../components/tools/ToolLayout.astro';
import '../../styles/tools.css';
---

<ToolLayout
  title="🔍 接口解析与格式化"
  description="粘贴 TVBox 配置 JSON，或填入配置地址在线抓取；解析后展示站点、直播、Spider 等结构摘要。全部在浏览器本地完成，不上传数据。"
>
  <div class="tool-page">
    <label class="field-label" for="parse-url">配置地址（可选，直接抓取）</label>
    <div class="btn-row" style="margin-top: 0">
      <input id="parse-url" type="url" placeholder="https://example.tv/config.json" style="flex: 1" />
      <button id="btn-fetch" class="btn btn-primary">抓取并解析</button>
    </div>

    <label class="field-label" for="parse-raw">配置 JSON 内容</label>
    <textarea
      id="parse-raw"
      rows="10"
      placeholder='粘贴接口配置 JSON，例如 {"spider": "...", "sites": [...]}'
    ></textarea>
    <div class="btn-row">
      <button id="btn-parse" class="btn btn-primary">解析</button>
      <button id="btn-sample" class="btn btn-ghost">填入示例</button>
      <button id="btn-clear" class="btn btn-ghost">清空</button>
    </div>

    <div id="alert-error" class="alert error"></div>
    <div id="alert-notice" class="alert info"></div>

    <div id="result-panel" class="result-panel" hidden>
      <div class="panel-head">
        <span>解析结果</span>
        <button id="btn-copy" class="btn btn-ghost">复制 JSON</button>
      </div>
      <div id="summary" class="stat-grid"></div>
      <pre class="output" id="output"></pre>
    </div>
  </div>
</ToolLayout>

<script src="../../scripts/parse.ts"></script>
