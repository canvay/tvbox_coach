 import type { LotusThemeConfig } from './theme';
 
+/**
+ * Prepend the Astro deployment base (import.meta.env.BASE_URL) so that
+ * theme-generated hrefs work when the site is served under a sub-path
+ * (e.g. GitHub Pages project sites at /<repo>/).
+ */
+function withDeployBase(href: string): string {
+  const base = (import.meta.env?.BASE_URL ?? '/').replace(/\/+$/, '');
+
+  if (!base || href === '/' || href.startsWith(`${base}/`) || href.startsWith('//')) {
+    return href;
+  }
+
+  return href === '' ? `${base}/` : `${base}${href}`;
+}
